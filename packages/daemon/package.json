{
  "name": "agentswitch-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentSwitch daemon: task routing (v1: router only)",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "route": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx src/cli.ts",
    "eval": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx scripts/router_eval.ts"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
