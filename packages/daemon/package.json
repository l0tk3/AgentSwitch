{
  "name": "agentswitch-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentSwitch daemon: task routing (v1: router only)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node --no-warnings=ExperimentalWarning dist/cli.js serve",
    "route": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx src/cli.ts",
    "serve": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx src/cli.ts serve",
    "cli": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx src/cli.ts",
    "eval": "NODE_OPTIONS=--no-warnings=ExperimentalWarning tsx scripts/router_eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@hono/node-server": "^2.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.8",
    "node-pty": "^1.1.0",
    "playwright-core": "1.64.0-alpha-1789764292000",
    "yaml": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
