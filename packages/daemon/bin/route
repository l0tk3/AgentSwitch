#!/usr/bin/env bash
# Route a task from any directory; the caller's cwd is what the router gets to read.
#   ~/Desktop/WorkSpace/Projects/AgentSwitch/packages/daemon/bin/route "任务" [--router echo] [--pin harness/model]
DIR="$(cd "$(dirname "$0")/.." && pwd)"
[ -d "$DIR/node_modules" ] || { echo "run: (cd $DIR && npm install)" >&2; exit 1; }
exec env NODE_OPTIONS=--no-warnings=ExperimentalWarning "$DIR/node_modules/.bin/tsx" "$DIR/src/cli.ts" route "$@"
