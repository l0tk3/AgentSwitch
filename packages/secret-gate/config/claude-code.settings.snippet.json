{
  "env": {
    "SECRET_GATE_HOME": "/Users/YOU/.secret-gate",
    "HTTPS_PROXY": "http://127.0.0.1:8080",
    "https_proxy": "http://127.0.0.1:8080",
    "HTTP_PROXY": "http://127.0.0.1:8080",
    "http_proxy": "http://127.0.0.1:8080",
    "NO_PROXY": "api.anthropic.com,.anthropic.com,claude.ai,.claude.ai,api.openai.com,api.deepseek.com,localhost",
    "no_proxy": "api.anthropic.com,.anthropic.com,claude.ai,.claude.ai,api.openai.com,api.deepseek.com,localhost",
    "SSL_CERT_FILE": "/Users/YOU/.secret-gate/ca.pem",
    "REQUESTS_CA_BUNDLE": "/Users/YOU/.secret-gate/ca.pem",
    "NODE_EXTRA_CA_CERTS": "/Users/YOU/.secret-gate/ca.pem"
  },
  "permissions": {
    "deny": [
      "Read(~/.secret-gate/**)",
      "Bash(cat ~/.secret-gate/*)",
      "Bash(secret-gate keygen*)"
    ]
  }
}
